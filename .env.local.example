# Stock 策略演进系统本机配置模板
# 复制为 .env.local（被 gitignore）后按本机实际填写；口令须与 DATABASE_URL 一致。
POSTGRES_PASSWORD=stock-local
DATABASE_URL=postgres://stock:stock-local@127.0.0.1:5432/stock
# 可选：测试库连接串；缺省时由 DATABASE_URL 派生（库名加 _test 后缀）
# TEST_DATABASE_URL=postgres://stock:stock-local@127.0.0.1:5432/stock_test
# 可选：HTTP 服务端口，缺省 8787
# PORT=8787
# 可选：第一阶段统一 Agent session 执行器开关，缺省启用；设为 false 可回退旧执行路径。
# 关闭不会回滚 0016 迁移或删除已保存的 session 证据。
# AGENT_SESSION_RUNNER_ENABLED=true
# 可选：第四阶段 Agent 临时代码回测开关。安全专项通过后缺省启用；设为 false 可紧急关闭工具。
# AGENT_BACKTEST_WORKER_ENABLED=true
# 标准日频研究路径无需Docker Socket；验收后由维护者显式开启。
# STANDARD_BACKTEST_ENABLED=false
# 可选：docker-compose 宿主端口，缺省 5432；本机 5432 被占用时改用如 55432，并同步修改 DATABASE_URL 端口
# POSTGRES_HOST_PORT=5432
# 可选：Web 工作台宿主端口，缺省 8787；始终只映射到 127.0.0.1
# APP_HOST_PORT=8787
# 可选：日更是否覆盖全市场个股，缺省 true。开启后每个交易日为全部活跃个股追加日线快照，
# 保证全市场历史持续更新；设为 false 时只更新持仓、标的池、核心指数和行业板块。
# 注意：指标与均线只对信号相关范围（持仓、标的池、核心指数、行业板块、结构候选）每日计算，
# 其余标的由每周任务 weekly_full_market_indicators 入队，后台分批补齐。
# DAILY_UPDATE_FULL_MARKET=true
# 可选：指标工作器两次领取之间的空闲等待毫秒，缺省 50。越小吞吐越高，但会持续占用 CPU；
# 设为 2000 可回退旧的低负载节奏。
# INDICATOR_WORKER_INTERVAL_MS=50
# 扶摇 API Key 在「设置 → 数据源凭据」维护；LLM 厂商、Base URL、API Key 与模型
# 在「设置 → AI 模型与厂商」维护。PostgreSQL 是唯一凭据事实源，不要在本文件配置 API Key。
